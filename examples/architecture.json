    },
    {
      "from": "cdn",
      "to": "api",
      "label": "HTTPS"
    },
    {
      "from": "api",
      "to": "db",
      "label": "SQL"
    },
    {
      "from": "api",
      "to": "queue"
    },
    {
      "from": "worker",
      "to": "queue",
      "label": "consume"
    }
  ],
  "focal": [
    "api"
  ],
  "note": "Hover a box to trace its connections"
}
