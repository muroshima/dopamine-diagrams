{
  "pattern": "architecture",
  "title": "リクエストはどこを通る？",
  "alt": "ブラウザとスマホアプリが CDN を呼び、CDN が API に転送する。API は Postgres に書き込み、キューにジョブを積む。ワーカーがキューから取り出して処理する。",
  "tiers": [
    {
      "name": "クライアント",
      "nodes": [
        {
          "id": "web",
          "label": "ブラウザ",
          "sub": "SPA"
        },
        {
          "id": "app",
          "label": "スマホアプリ"
        }
      ]
    },
    {
      "name": "エッジ",
      "nodes": [
        {
          "id": "cdn",
          "label": "CDN",
          "sub": "キャッシュ + WAF"
        }
      ]
    },
    {
      "name": "バックエンド",
      "nodes": [
        {
          "id": "api",
          "label": "API",
          "sub": "ステートレス"
        },
        {
          "id": "worker",
          "label": "ワーカー"
        }
      ]
    },
    {
      "name": "データ",
      "nodes": [
        {
          "id": "db",
          "label": "Postgres"
        },
        {
          "id": "queue",
          "label": "キュー"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "web",
      "to": "cdn"
    },
    {
      "from": "app",
      "to": "cdn"
    },
    {
      "from": "cdn",
      "to": "api",
      "label": "HTTPS"
    },
    {
      "from": "api",
      "to": "db",
      "label": "SQL"
    },
    {
      "from": "api",
      "to": "queue"
    },
    {
      "from": "worker",
      "to": "queue",
      "label": "取り出す"
    }
  ],
  "focal": [
    "api"
  ],
  "note": "箱にマウスを乗せると、つながる線だけが光ります"
}
