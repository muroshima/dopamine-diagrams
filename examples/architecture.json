          "id": "app",
          "label": "Mobile app"
        }
      ]
    },
    {
      "name": "EDGE",
      "nodes": [
        {
          "id": "cdn",
          "label": "CDN",
          "sub": "cache + WAF"
        }
      ]
    },
    {
      "name": "BACKEND",
      "nodes": [
        {
          "id": "api",
          "label": "API",
          "sub": "stateless"
        },
        {
          "id": "worker",
          "label": "Worker"
        }
      ]
    },
    {
      "name": "DATA",
      "nodes": [
        {
          "id": "db",
          "label": "Postgres"
        },
        {
          "id": "queue",
          "label": "Queue"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "web",
      "to": "cdn"
    },
    {
      "from": "app",
